M18. Function years_employed(p_emp_id) RETURN NUMBER (MONTHS_BETWEEN/12). Hint: SELECT MONTHS_BETWEEN(SYSDATE, hire_date)/12 INTO v FROM hr.employees WHERE employee_id = p_emp_id; RETURN v;

CREATE OR REPLACE FUNCTION years_employed (p_emp_id NUMBER)
RETURN NUMBER
IS
   v_years NUMBER;
BEGIN
   SELECT MONTHS_BETWEEN(SYSDATE, hire_date) / 12
   INTO v_years
   FROM departments
   WHERE employee_id = p_emp_id;

   RETURN v_years;

EXCEPTION
   WHEN NO_DATA_FOUND THEN
      RETURN 0;
END;
/
M19. Function that returns 1 if department exists, 0 otherwise. Hint: SELECT COUNT(*) INTO v FROM hr.departments WHERE department_id = p_dept_id; RETURN CASE WHEN v > 0 THEN 1 ELSE 0 END;

CREATE OR REPLACE FUNCTION dept_exists (p_dept_id NUMBER)
RETURN NUMBER
IS
   v NUMBER;
BEGIN
   SELECT COUNT(*)
   INTO v
   FROM departments
   WHERE department_id = p_dept_id;

   RETURN CASE WHEN v > 0 THEN 1 ELSE 0 END;
END;
/
