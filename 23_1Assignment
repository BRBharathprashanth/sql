M14. Function dept_has_employees(p_dept_id) RETURN NUMBER (1 if count>0, 0 else). Hint: v := 0; SELECT COUNT(*) INTO c FROM ...; IF c > 0 THEN v := 1; END IF; RETURN v;

CREATE OR REPLACE FUNCTION dept_has_employees (p_dept_id NUMBER)
RETURN NUMBER
IS
   c NUMBER;
BEGIN
   SELECT COUNT(*)
   INTO c
   FROM departments
   WHERE department_id = p_dept_id;

   IF c > 0 THEN
      RETURN 1;
   ELSE
      RETURN 0;
   END IF;
END;
/
