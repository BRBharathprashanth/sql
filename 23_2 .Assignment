H1. Function that returns BOOLEAN: dept_has_employees(p_dept_id). 
Call from PL/SQL only. Hint: RETURN (SELECT COUNT() FROM hr.employees WHERE department_id = p_dept_id) > 0;or SELECT COUNT() INTO v; RETURN v > 0; 

CREATE OR REPLACE FUNCTION dept_exists(p_dept_id NUMBER)
RETURN BOOLEAN
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN v_count > 0;
END;
/

H2. Function used in function-based index: UPPER(last_name) — create function my_upper(p_val) DETERMINISTIC RETURN UPPER(p_val); Hint: Must be DETERMINISTIC; CREATE INDEX idx ON hr.employees(my_upper(last_name)); 

CREATE OR REPLACE FUNCTION my_upper(p_val VARCHAR2)
RETURN VARCHAR2 DETERMINISTIC
IS
BEGIN
    RETURN UPPER(p_val);
END;
/

CREATE INDEX idx_dept_name
ON departments(my_upper(department_name));

H3. Function that returns VARCHAR2: list of employee last_names in department (LISTAGG). Hint: SELECT LISTAGG(last_name, ', ') WITHIN GROUP (ORDER BY last_name) INTO v FROM hr.employees WHERE department_id = p_dept_id; RETURN v; 
CREATE OR REPLACE FUNCTION list_departments
RETURN VARCHAR2
IS
    v_result VARCHAR2(4000);
BEGIN
    SELECT LISTAGG(department_name, ', ')
    WITHIN GROUP (ORDER BY department_name)
    INTO v_result
    FROM departments;

    RETURN v_result;
END;
/

H4. Function with exception: return NULL on NO_DATA_FOUND, re-raise TOO_MANY_ROWS. Hint: EXCEPTION WHEN NO_DATA_FOUND THEN RETURN NULL; WHEN TOO_MANY_ROWS THEN RAISE; 

CREATE OR REPLACE FUNCTION get_dept_name(p_dept_id NUMBER)
RETURN VARCHAR2
IS
    v_name departments.department_name%TYPE;
BEGIN
    SELECT department_name INTO v_name
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN v_name;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN NULL;
    WHEN TOO_MANY_ROWS THEN
        RAISE;
END;
/

H5. Function that takes job_id and department_id, returns count of employees. Hint: SELECT COUNT(*) INTO v FROM hr.employees WHERE job_id = p_job_id AND department_id = p_dept_id; RETURN v;

CREATE OR REPLACE FUNCTION count_by_location(p_location_id NUMBER)
RETURN NUMBER
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM departments
    WHERE location_id = p_location_id;

    RETURN v_count;
END;
/

H6. Function returning DATE: earliest hire_date in department. Hint: SELECT MIN(hire_date) INTO v FROM hr.employees WHERE department_id = p_dept_id; RETURN v;

CREATE OR REPLACE FUNCTION min_department_id
RETURN NUMBER
IS
    v_min NUMBER;
BEGIN
    SELECT MIN(department_id) INTO v_min FROM departments;
    RETURN v_min;
END;
/

H7. Function in SELECT with GROUP BY: department_id, get_department_name(department_id). Hint: SELECT department_id, get_department_name(department_id) FROM hr.employees GROUP BY department_id;

CREATE OR REPLACE FUNCTION get_department_name(p_dept_id NUMBER)
RETURN VARCHAR2
IS
    v_name VARCHAR2(100);
BEGIN
    SELECT department_name INTO v_name
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN v_name;
END;
/

-- Usage
SELECT department_id, get_department_name(department_id)
FROM departments
GROUP BY department_id;

H8. Function salary_band(p_salary) RETURN VARCHAR2: 'Low'/<5000, 'Mid'/<10000, 'High'. Hint: RETURN CASE WHEN p_salary < 5000 THEN 'Low' WHEN p_salary < 10000 THEN 'Mid' ELSE 'High' END;

CREATE OR REPLACE FUNCTION dept_band(p_dept_id NUMBER)
RETURN VARCHAR2
IS
BEGIN
    RETURN CASE
        WHEN p_dept_id < 50 THEN 'Low'
        WHEN p_dept_id < 100 THEN 'Mid'
        ELSE 'High'
    END;
END;
/

H9. Function that returns manager's last_name for employee_id (self-join in function). Hint: SELECT m.last_name INTO v FROM hr.employees e JOIN hr.employees m ON e.manager_id = m.employee_id WHERE e.employee_id = p_emp_id; RETURN v;

CREATE OR REPLACE FUNCTION get_manager_name(p_dept_id NUMBER)
RETURN VARCHAR2
IS
    v_mgr NUMBER;
BEGIN
    SELECT manager_id INTO v_mgr
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN TO_CHAR(v_mgr);
END;
/

H10. Function with OUT parameter (not for SQL use): get_emp_info(p_emp_id, p_name OUT) RETURN salary. Hint: Function can have OUT but then cannot use in SQL SELECT; RETURN v_salary;

CREATE OR REPLACE FUNCTION get_dept_info(
    p_dept_id NUMBER,
    p_name OUT VARCHAR2
)
RETURN NUMBER
IS
    v_loc NUMBER;
BEGIN
    SELECT department_name, location_id
    INTO p_name, v_loc
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN v_loc;
END;
/

H11. Function that returns NUMBER: difference between employee salary and department avg. Hint: Get employee salary and department avg (two SELECTs or one with subquery); RETURN v_sal - v_avg;

CREATE OR REPLACE FUNCTION dept_diff(p_dept_id NUMBER)
RETURN NUMBER
IS
    v_avg NUMBER;
BEGIN
    SELECT AVG(department_id) INTO v_avg FROM departments;
    RETURN p_dept_id - v_avg;
END;
/

H12. Function department_name_length(p_dept_id) RETURN NUMBER. Hint: SELECT LENGTH(department_name) INTO v FROM hr.departments WHERE department_id = p_dept_id; RETURN v;

CREATE OR REPLACE FUNCTION department_name_length(p_dept_id NUMBER)
RETURN NUMBER
IS
    v_len NUMBER;
BEGIN
    SELECT LENGTH(department_name)
    INTO v_len
    FROM departments
    WHERE department_id = p_dept_id;

    RETURN v_len;
END;
/

H13. Use function in CASE: SELECT CASE WHEN employee_count(department_id) > 10 THEN 'Large' ... Hint: CASE WHEN employee_count(department_id) > 10 THEN 'Large' ELSE 'Small' END FROM hr.departments;

CREATE OR REPLACE FUNCTION dept_count(p_location_id NUMBER)
RETURN NUMBER
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM departments
    WHERE location_id = p_location_id;

    RETURN v_count;
END;
/

-- Usage
SELECT department_id,
       CASE
           WHEN dept_count(location_id) > 2 THEN 'Large'
           ELSE 'Small'
       END
FROM departments;

H14. Function that returns total salary of employees reporting to a given manager_id. Hint: SELECT NVL(SUM(salary),0) INTO v FROM hr.employees WHERE manager_id = p_mgr_id; RETURN v;

CREATE OR REPLACE FUNCTION total_by_manager(p_mgr_id NUMBER)
RETURN NUMBER
IS
    v_total NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_total
    FROM departments
    WHERE manager_id = p_mgr_id;

    RETURN v_total;
END;
/

H15. Function returning VARCHAR2: 'YES'/'NO' if department has any employee with commission_pct > 0. Hint: SELECT COUNT(*) INTO v FROM hr.employees WHERE department_id = p_dept_id AND commission_pct > 0; RETURN CASE WHEN v > 0 THEN 'YES' ELSE 'NO' END;

CREATE OR REPLACE FUNCTION has_location(p_location_id NUMBER)
RETURN VARCHAR2
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM departments
    WHERE location_id = p_location_id;

    RETURN CASE
        WHEN v_count > 0 THEN 'YES'
        ELSE 'NO'
    END;
END;
/

H16. Function with two IN parameters returning NUMBER: ratio of two department counts. Hint: c1 := employee_count(p_dept1); c2 := employee_count(p_dept2); RETURN c1/NULLIF(c2,0);

CREATE OR REPLACE FUNCTION dept_ratio(p_loc1 NUMBER, p_loc2 NUMBER)
RETURN NUMBER
IS
    c1 NUMBER;
    c2 NUMBER;
BEGIN
    SELECT COUNT(*) INTO c1 FROM departments WHERE location_id = p_loc1;
    SELECT COUNT(*) INTO c2 FROM departments WHERE location_id = p_loc2;

    RETURN c1 / NULLIF(c2, 0);
END;
/

H17. Function that returns employee_id of highest-paid in department (handle tie: return one). Hint: SELECT employee_id INTO v FROM (SELECT employee_id FROM hr.employees WHERE department_id = p_dept_id ORDER BY salary DESC FETCH FIRST 1 ROW ONLY); RETURN v;

CREATE OR REPLACE FUNCTION max_dept_id
RETURN NUMBER
IS
    v_id NUMBER;
BEGIN
    SELECT department_id INTO v_id
    FROM (
        SELECT department_id
        FROM departments
        ORDER BY department_id DESC
    )
    WHERE ROWNUM = 1;

    RETURN v_id;
END;
/

H18. Pipelined function (advanced): return rows of (employee_id, last_name) for department. Hint: PIPELINED; PIPE ROW(...); RETURN; (advanced topic)

CREATE OR REPLACE TYPE dept_obj AS OBJECT (
    dept_id NUMBER,
    dept_name VARCHAR2(100)
);
/

CREATE OR REPLACE TYPE dept_tab AS TABLE OF dept_obj;
/

CREATE OR REPLACE FUNCTION pipe_departments
RETURN dept_tab PIPELINED
IS
BEGIN
    FOR rec IN (SELECT department_id, department_name FROM departments)
    LOOP
        PIPE ROW(dept_obj(rec.department_id, rec.department_name));
    END LOOP;

    RETURN;
END;
/

H19. Function used in CHECK constraint (Oracle 11g+): constraint check (my_func(salary) = 1). Hint: Function must be DETERMINISTIC and declared in same schema; CHECK (validate_salary(salary) = 1)

CREATE OR REPLACE FUNCTION validate_dept(p_id NUMBER)
RETURN NUMBER DETERMINISTIC
IS
BEGIN
    IF p_id > 0 THEN
        RETURN 1;
    ELSE
        RETURN 0;
    END IF;
END;
/

ALTER TABLE departments
ADD CONSTRAINT chk_dept
CHECK (validate_dept(department_id) = 1);

H20. Function that returns default department_id if p_dept_id is NULL: NVL(p_dept_id, 50). Hint: RETURN NVL(p_dept_id, 50); or IF p_dept_id IS NULL THEN RETURN 50; ELSE RETURN p_dept_id; END IF;

CREATE OR REPLACE FUNCTION default_dept(p_dept_id NUMBER)
RETURN NUMBER
IS
BEGIN
    RETURN NVL(p_dept_id, 50);
END;
/
