Q4: Write a PL/SQL block that performs an UPDATE and commits only if at least one row is updated; otherwise, roll back the transaction.
A:

BEGIN
    UPDATE hr_employees
    SET salary = salary * 2.0
    WHERE department_id = 110;

    IF SQL%ROWCOUNT = 0 THEN
        ROLLBACK;
    ELSE
        COMMIT;
    END IF;
END;


Q5: Create a procedure that updates all rows in hr_employees and commits the transaction at the end.
A:

CREATE OR REPLACE PROCEDURE update_hr_employees
IS
BEGIN
    UPDATE hr_employees
    SET salary = salary * 1.1;
    COMMIT;
END;
/

Q6: Write a PL/SQL block that performs an UPDATE and ensures that if any error occurs, all changes are rolled back and the error is re-raised.
A:

BEGIN
    UPDATE hr_employees
    SET salary = salary * 1.1
    WHERE department_id = 110;
    COMMIT;
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END;

Q7: Write a block with two SAVEPOINTs. Perform two updates and roll back to the first savepoint. Which updates are preserved?
A:

BEGIN
    UPDATE hr_employees SET salary = salary + 1000 WHERE department_id = 110;
    SAVEPOINT after_first;

    UPDATE hr_employees SET salary = salary + 500 WHERE department_id = 90;
    SAVEPOINT after_second;

    ROLLBACK TO after_first;
    COMMIT;
END;

Q8: Write a block that updates one row, sets a SAVEPOINT, deletes another row, then rolls back to the savepoint and commits. What is the final result?
A:

BEGIN 
    UPDATE hr_employees SET salary = salary * 2.0 WHERE department_id = 40;
    SAVEPOINT sp1;

    DELETE FROM hr_employees WHERE employee_id = 102;

    ROLLBACK TO sp1;
    COMMIT;
END;

