Q13: Create a procedure that performs two updates and commits only if both updates affect at least one row; otherwise, roll back.
A:

CREATE OR REPLACE PROCEDURE update_two_steps
IS
    v1 NUMBER;
    v2 NUMBER;
BEGIN
    UPDATE hr_employees SET salary = salary + 500 WHERE department_id = 101;
    v1 := SQL%ROWCOUNT;

    UPDATE hr_employees SET salary = salary + 300 WHERE department_id = 206;
    v2 := SQL%ROWCOUNT;

    IF v1 > 0 AND v2 > 0 THEN
        COMMIT;
    ELSE
        ROLLBACK;
    END IF;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END;
/

Q14: Write a block that sets a SAVEPOINT before a loop that updates rows, and rolls back to that savepoint if an error occurs.
A:

DECLARE
BEGIN
    SAVEPOINT before_loop;

    FOR rec IN (SELECT employee_id FROM hr_employees WHERE department_id = 101) LOOP
        UPDATE hr_employees
        SET salary = salary + 100
        WHERE employee_id = rec.employee_id;
    END LOOP;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_loop;
        RAISE;
END;
/

