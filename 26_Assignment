Q19: Write a procedure that updates rows using a cursor and commits every 10 rows.
A:

CREATE OR REPLACE PROCEDURE update_in_batches
IS
    CURSOR c1 IS SELECT employee_id FROM hr_employees;
    v_count NUMBER := 0;
BEGIN
    FOR rec IN c1 LOOP
        UPDATE hr_employees
        SET salary = salary + 100
        WHERE employee_id = rec.employee_id;

        v_count := v_count + 1;

        IF MOD(v_count, 10) = 0 THEN
            COMMIT;
        END IF;
    END LOOP;

    COMMIT;
END;
/

