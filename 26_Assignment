Q11: Write a block that updates multiple rows and displays how many rows were affected using SQL%ROWCOUNT.
A:

DECLARE
    v_rows NUMBER;
BEGIN
    UPDATE hr_employees
    SET salary = salary + 1000
    WHERE department_id = 50;

    v_rows := SQL%ROWCOUNT;

    DBMS_OUTPUT.PUT_LINE('Rows updated: ' || v_rows);

    COMMIT;
END;

